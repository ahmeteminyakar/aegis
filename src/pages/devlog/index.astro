---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import EntryCard from "../../components/devlog/EntryCard.astro";

// Devlog index. Lists all non-draft entries in production. In dev, also
// shows drafts so Ahmet can preview without committing. Sorted by date
// desc; ties broken by filename so the list is fully deterministic.

const includeDrafts = !import.meta.env.PROD;

const entries = (
  await getCollection("devlog", ({ data }) => includeDrafts || !data.draft)
).sort((a, b) => {
  const dt = b.data.date.getTime() - a.data.date.getTime();
  return dt !== 0 ? dt : a.id.localeCompare(b.id);
});

const stripDate = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const count = entries.length;
---

<Layout
  title="aegis devlog."
  description="Build journal for the Aegis Peltier wristband. Honest about what works and what doesn't."
>
  <header class="border-b border-grid">
    <nav class="mx-auto max-w-[1280px] px-6 sm:px-10 h-14 flex items-center justify-between">
      <a href="/" class="font-mono text-[13px] tracking-[0.08em] text-fg-muted hover:text-fg transition-colors duration-200">
        ← aegis
      </a>
      <a href="/rss.xml" class="font-mono text-[12px] tracking-[0.06em] text-fg-muted hover:text-fg transition-colors duration-200">
        rss
      </a>
    </nav>
  </header>

  <main>
    <section class="mx-auto max-w-[1280px] px-6 sm:px-10 pt-20 sm:pt-28 pb-12 sm:pb-16">
      <div class="flex items-baseline justify-between mb-10">
        <span class="mono-label">devlog</span>
        <span class="mono-label tabular">
          {count === 1 ? "1 entry" : `${count} entries`}
        </span>
      </div>
      <h1 class="font-sans font-medium text-[44px] sm:text-[64px] leading-[1.02] tracking-[-0.02em] text-fg max-w-[760px]">
        Build journal.
      </h1>
      <p class="mt-8 max-w-[560px] text-[17px] leading-[1.55] text-fg-muted">
        Honest about what works and what doesn't. New entries land when there
        is something real to write about.
      </p>
    </section>

    {count === 0 ? (
      <section class="mx-auto max-w-[1280px] px-6 sm:px-10 pb-32">
        <div class="border border-dashed border-grid p-10 sm:p-14 min-h-[220px] flex flex-col justify-center items-center text-center">
          <span class="mono-label">empty.state</span>
          <p class="mt-6 font-mono text-[13px] tracking-[0.06em] text-fg-muted">
            no entries yet. git log will catch up first.
          </p>
        </div>
      </section>
    ) : (
      <section class="border-t border-grid">
        <ol>
          {entries.map((entry) => (
            <li>
              <EntryCard entry={entry} slug={stripDate(entry.id)} />
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="mx-auto max-w-[1280px] px-6 sm:px-10 py-16 mt-8 border-t border-grid">
      <div class="flex flex-wrap items-baseline justify-between gap-4 font-mono text-[12px] tracking-[0.04em] text-fg-muted">
        <a href="/" class="hover:text-fg transition-colors duration-200">← aegis page</a>
        <span>built in the open.</span>
      </div>
    </footer>
  </main>
</Layout>
