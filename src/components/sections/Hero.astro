---
import fs from "node:fs";
import path from "node:path";
import HeroIsland from "../Hero.tsx";

// Hero shell. Static Astro markup wraps a React island for the text
// entrance. The video element lives here so it streams as a plain
// asset, not bundled by React. When public/media/hero.mp4 is absent
// (v0 — Ahmet hasn't dropped the Midjourney export yet), we render
// a CSS-only thermal-gradient fallback instead of a 404'd <video>.
const projectRoot = process.cwd();
const hasHeroVideo = fs.existsSync(path.join(projectRoot, "public/media/hero.mp4"));
const hasHeroPoster = fs.existsSync(path.join(projectRoot, "public/media/hero-poster.webp"));
---

<section id="top" class="relative min-h-[100svh] w-full overflow-hidden flex items-end pb-[14vh] sm:pb-[18vh]">
  {hasHeroVideo ? (
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-70"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={hasHeroPoster ? "/media/hero-poster.webp" : undefined}
      aria-hidden="true"
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
  ) : (
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse 70% 60% at 12% 20%, rgba(217,107,58,0.22), transparent 62%),
        radial-gradient(ellipse 60% 65% at 88% 78%, rgba(63,180,212,0.18), transparent 65%),
        radial-gradient(ellipse 50% 40% at 50% 55%, rgba(217,107,58,0.08), transparent 70%),
        linear-gradient(180deg, #08080a 0%, #0a0a0b 100%);"
      aria-hidden="true"
    >
      <span class="absolute bottom-6 left-1/2 -translate-x-1/2 mono-label">
        backdrop · awaiting capture
      </span>
    </div>
  )}

  <div
    class="absolute inset-0 z-[1]"
    style="background:
      linear-gradient(180deg, rgba(10,10,11,0.35) 0%, rgba(10,10,11,0) 30%, rgba(10,10,11,0.92) 88%, var(--color-bg) 100%);"
    aria-hidden="true"
  ></div>

  <HeroIsland client:load />

  <div class="absolute inset-x-0 top-20 z-[2] flex justify-between px-6 sm:px-10 pointer-events-none">
    <span class="mono-label">lat 47.61 / lon -122.33</span>
    <span class="mono-label">ambient 21.4&deg;c / skin 33.2&deg;c</span>
  </div>
</section>
