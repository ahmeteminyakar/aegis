---
// Pattern study: pmndrs.com's lean three-column footer — links live
// here, no newsletter signup duplicated. Mono throughout because the
// footer is plumbing, not display copy.
---

<footer class="relative mt-8 pb-12">
  <div class="hairline mb-14"></div>

  <div class="mx-auto max-w-[1280px] px-6 sm:px-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div>
        <a href="#top" class="font-mono text-[15px] tracking-[0.08em] text-fg">aegis</a>
        <p class="mt-4 font-mono text-[11px] leading-[1.6] text-fg-muted max-w-[220px]">
          a wearable thermal-comfort device, designed in the open.
        </p>
      </div>

      <nav aria-label="Project">
        <span class="mono-label block mb-4">project</span>
        <ul class="space-y-2 font-mono text-[12px]">
          <li><a href="#devlog" class="text-fg-muted hover:text-fg transition-colors duration-200">devlog</a></li>
          <li><a href="#newsletter" class="text-fg-muted hover:text-fg transition-colors duration-200">newsletter</a></li>
          <li><a href="https://github.com/ahmeteminyakar" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors duration-200">github ↗</a></li>
        </ul>
      </nav>

      <nav aria-label="Background">
        <span class="mono-label block mb-4">background</span>
        <ul class="space-y-2 font-mono text-[12px]">
          <li><a href="https://embrlabs.com" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors duration-200">embr wave ↗</a></li>
          <li><a href="https://en.wikipedia.org/wiki/Thermal_comfort" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors duration-200">pmv/ppd research ↗</a></li>
          <li><a href="https://en.wikipedia.org/wiki/Thermoelectric_cooling" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors duration-200">peltier effect ↗</a></li>
        </ul>
      </nav>

      <nav aria-label="Author">
        <span class="mono-label block mb-4">author</span>
        <ul class="space-y-2 font-mono text-[12px]">
          <li><a href="https://github.com/ahmeteminyakar" target="_blank" rel="noopener" class="text-fg-muted hover:text-fg transition-colors duration-200">ahmet emin yakar ↗</a></li>
        </ul>
      </nav>
    </div>

    <div class="hairline mb-6"></div>

    <div class="flex flex-col sm:flex-row gap-3 sm:gap-0 sm:items-baseline sm:justify-between font-mono text-[11px] tracking-[0.04em] text-fg-muted">
      <span>&#169; 2026 ahmet. built in the open.</span>
      <span class="tabular">v0.1 / concept</span>
    </div>
  </div>
</footer>
