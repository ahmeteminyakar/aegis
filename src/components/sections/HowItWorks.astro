---
// Pattern study: Linear's bordered card row with mono ordinals as the
// dominant visual element (no icons). Card grid uses gap-px on grid-
// background trick so 1px lines bleed through between cards for a
// hairline-divided block.

const cards = [
  {
    ord: "01 / adaptive",
    title: "Closed-loop comfort.",
    body: "Skin-temp sensor, ambient sensor, IMU. The control loop targets the 32 to 34&#176;c thermal-comfort band, PWM-modulates the TEC duty cycle to keep average wattage low, and bursts on demand.",
    foot: "PID + feedforward, 10 Hz loop",
  },
  {
    ord: "02 / manual",
    title: "One touchpoint.",
    body: "A single capacitive contact on the underside of the band. Long-press to switch between cool and heat. Short-press to trigger a three-minute burst.",
    foot: "Polarity reversal via H-bridge",
  },
  {
    ord: "03 / battery",
    title: "Honest about runtime.",
    body: "Continuous TEC operation drains a wristband-sized LiPo in about 45 minutes. Aegis is a burst device by design. Two to three hours of typical-use cycling. Charging via USB-C.",
    foot: "500 mAh LiPo, BMS-protected",
  },
];
---

<section id="how-it-works" class="relative">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-10 py-32 sm:py-40">
    <div class="mb-16 flex items-baseline justify-between border-b border-grid pb-6">
      <span class="mono-label">02 / control surfaces</span>
      <span class="mono-label tabular hidden sm:inline">two modes · one loop</span>
    </div>

    <h2 class="font-sans font-medium text-[34px] sm:text-[44px] leading-[1.05] tracking-[-0.02em] text-fg mb-16 max-w-[760px]">
      Two modes. One control loop.
      <br />
      <span class="text-fg-muted">No magic.</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-grid border border-grid">
      {cards.map((card) => (
        <article class="bg-bg-elevated p-8 sm:p-10 min-h-[340px] flex flex-col">
          <div class="mono-ord">{card.ord}</div>
          <div class="mt-12 flex-1">
            <h3 class="font-sans text-[22px] leading-[1.2] tracking-[-0.01em] text-fg mb-4">
              {card.title}
            </h3>
            <p class="text-[15px] leading-[1.6] text-fg-muted" set:html={card.body} />
          </div>
          <div class="mt-10 pt-5 border-t border-grid">
            <span class="mono-label">{card.foot}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
