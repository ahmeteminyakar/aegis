---
// Pattern study: Resend's signup band — restrained, single input, no
// "join 10,000+ readers" social proof (there is none). Form action is
// a no-op for v0; comment marks the wiring point.
---

<section id="newsletter" class="relative">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-10 py-32 sm:py-40">
    <div class="mb-16 flex items-baseline justify-between border-b border-grid pb-6">
      <span class="mono-label">06 / signal</span>
      <span class="mono-label tabular hidden sm:inline">low frequency</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[5fr_6fr] gap-12 lg:gap-20 items-start">
      <div class="max-w-[480px]">
        <h2 class="font-sans font-medium text-[34px] sm:text-[44px] leading-[1.05] tracking-[-0.02em] text-fg">
          Get build updates.
        </h2>
        <p class="mt-8 text-[16px] sm:text-[17px] leading-[1.65] text-fg-muted">
          One email when there is something real to show. No marketing.
        </p>
      </div>

      <div class="w-full max-w-[520px] justify-self-start lg:justify-self-end">
        <form id="newsletter-form" class="space-y-3" novalidate>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@somewhere.dev"
            class="input-mono"
          />
          <button type="submit" class="btn-mono w-full sm:w-auto sm:min-w-[180px]">
            subscribe
          </button>
        </form>

        <p id="newsletter-success" class="hidden mt-4 font-mono text-[12px] tracking-[0.06em] text-accent-cold" role="status">
          thanks. saved.
        </p>
        <p id="newsletter-error" class="hidden mt-4 font-mono text-[12px] tracking-[0.06em] text-accent-hot" role="status">
          that doesn't look like an email.
        </p>

        <p class="mt-8 font-mono text-[11px] text-fg-muted max-w-[420px] leading-[1.55]">
          stored locally for now. wired to a real list when there is one
          subscriber besides me.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById("newsletter-form");
    const success = document.getElementById("newsletter-success");
    const error = document.getElementById("newsletter-error");
    if (!form || !success || !error) return;

    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      error.classList.add("hidden");
      const email = new FormData(form).get("email");
      if (typeof email !== "string" || !EMAIL.test(email)) {
        error.classList.remove("hidden");
        return;
      }
      // Wiring point. Swap for fetch('/api/subscribe', { method: 'POST', body: ... })
      // backed by Cloudflare Workers + KV or a Resend/ConvertKit API call.
      console.log("[newsletter v0]", email);
      form.reset();
      success.classList.remove("hidden");
      setTimeout(() => success.classList.add("hidden"), 4000);
    });
  })();
</script>
